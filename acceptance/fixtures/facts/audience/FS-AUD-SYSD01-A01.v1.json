  "pain_points": {
    "status": "CONFIRMED",
    "value": [
      "上午会议要有边界感，晚上接孩子又不想显得过度正式，硬挺西装常在第二个场景里变得突兀",
      "通勤单程 40—60 分钟，久坐后裤腰勒、腹部褶皱和膝盖鼓包比镜子里的第一眼更影响体验",
      "体重一年内上下浮动 3—5 公斤，不愿每次变化都重买一套裤装",
      "线上详情页经常只说面料名称，不说里料、重量、清洗和容易出现的问题，收到货后才发现不适合高频穿",
      "已有很多“单看好看”的衣服，真正缺的是能与现有鞋、包、裤装连续搭配的中坚款"
    ],
